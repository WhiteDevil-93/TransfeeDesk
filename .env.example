SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
APP_DB_SECRET=
PORT=5000
HOST=127.0.0.1
# Set to 1 to run the 14-day HPCSA bulk refresh inside the web process (off by default).
HPCSA_AUTO_REFRESH=0
# Web Push (generate once with: npx web-push generate-vapid-keys). Leave empty to switch push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
