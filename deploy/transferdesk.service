[Unit]
Description=TransferDesk referral API and web application
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/transferdesk/runtime.env

[Service]
Type=simple
User=transferdesk
Group=transferdesk
WorkingDirectory=/opt/transferdesk/current
Environment=NODE_ENV=production
EnvironmentFile=/var/lib/transferdesk/runtime.env
ExecStart=/opt/transferdesk/node/bin/node dist/index.cjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/transferdesk
MemoryMax=1G
TasksMax=128
UMask=0077

[Install]
WantedBy=multi-user.target
